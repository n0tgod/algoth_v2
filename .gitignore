.venv/
__pycache__/
*.pyc
# Ключи площадки: живут вне репозитория (~/.bybit), но если копия
# однажды окажется внутри — git её не возьмёт.
*.env

# служебный замок очереди
jobs/.lock

# запись стакана и её служебные каталоги: кэш часов из хранилища,
# частичный ход выгрузки, состояние замера — не в git (publish.sh
# добавляет research/*/out целиком)
research/b1_book/out/cache/
research/b1_book/out/ship/*.part.json
research/b1_book/out/ship/*.tmp
research/b1_book/out/*.state
research/b1_book/out/ship.log

# состояние API приложения: база аккаунтов, конверты ключей, TLS и токены — никогда в git
tools/app_api/out/

# кэш ног листа (run_d6.gated_legs, 15.10): пересчитывается по подписи, в git не идёт
research/dca_ladder/out/legs_cache.pkl
research/dca_ladder/out/legs_cache.pkl.tmp
# разобранные куски журналов DCA (rules.read_journal disk=…, 15.10): пересоздаются по подписи
research/dca_paper/out/journal_cache/
# флаг цикла S8 «обучение ждёт памяти или идёт» (train.py, 15.10) — состояние процесса, не запись
research/s8_loop/out/train_wait.flag
research/s8_loop/out/train_wait.flag.tmp
# кэш минутных баров ленты для прогонов книг (sweep.read_bars cache=…, 15.10)
research/dca_paper/out/bars_cache/
# кэш контекста издержек (costs.context cache=…, 15.10) — пересоздаётся по подписи каталога funding
research/dca_paper/out/costs_context.pkl
research/dca_paper/out/costs_context.pkl.tmp
# запись состояния рынка (спека 19 §3b): строки по суткам, ≈ 5 МБ/сут,
# последняя метка на имя и список виденных событий — не в git; в git
# идут сводка latest.json и отчёт
research/market_state/out/record/
research/market_state/out/collect.log
# запись новостного фона (спека 19 §4): тексты чужих изданий в git не идут;
# в git — сводка latest.json и отчёт
research/news/out/record/
research/news/out/collect.log
# журнал решений судьи с досье (спека 19): тексты новостей внутри — вне git
research/ai_gate/out/record/
research/ai_gate/out/gate.log
research/ai_gate/out/gate_books.log

# graphify (21.10): граф кода (`graphify-out/`, 14 МБ) в git НЕ идёт — сервер
# тянет main каждую минуту, а граф пересобирается хуком начала сессии за
# 2 мин из кода (tools/graphify_setup.sh); правила — .claude/CLAUDE.md
graphify-out/
