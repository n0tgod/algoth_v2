# Хранилище — данные исследования, не место для git
out/parquet/
out/*.duckdb
out/*.log
out/*.err
out/.tmp/
.tmp/

# Коммитятся: out/A2-hygiene-report.md, out/hygiene.json

__pycache__/
*.pyc

# Сводка сборки — пересоздаётся прогоном. Незаконченная сборка описывает
# остаток работы, а не хранилище, поэтому по умолчанию не коммитится;
# законченная добавляется принудительно (`git add -f`) рядом с отчётом.
out/build_*.json
